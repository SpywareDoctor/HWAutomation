{
  "manifest_version": 3,
  "name": "HackerWars Automator",
  "version": "2.1.0",
  "description": "Manual-trigger automation helper for hackerwars.io",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "alarms"],
  "host_permissions": ["https://hackerwars.io/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HackerWars Automator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hackerwars.io/*"],
      "js": ["shared.js", "logs.js", "missions.js", "ddos.js", "research.js", "puzzle.js", "masshack.js", "collect.js", "repgrind.js", "repkill.js", "softwareGather.js", "popup.js", "overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["https://hackerwars.io/*"]
    }
  ]
}
